# 运行/测试产物
node_modules/
.test-sandbox/         # 旧路径（留着，免得历史残留被提交）
.test-sandbox-*/       # 按进程分的测试沙箱：两套测试并行跑不会互相覆盖（见 test/run-tests.mjs 注释）
.preflight-store/
.tmp-*/
.dbg/
.probe*
*.log

# 安装备份（安装脚本生成的）
*.bak-memory-*
*.bak2-memory-*
*.bak3-memory-*

# 打包产物与临时缓存（npm pack 时用 --cache 指进仓库，免得写到工作区外的 npm-cache）
*.tgz
.npm-cache/
